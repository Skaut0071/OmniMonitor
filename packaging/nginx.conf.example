# Example nginx config for putting OmniMonitor behind HTTPS.
#
# Unlike Caddy, nginx doesn't get you a certificate on its own - get one
# first (e.g. `certbot --nginx`, which can also rewrite this file for
# you), then adjust the ssl_certificate paths below. Copy this to
# /etc/nginx/sites-available/omnimonitor.conf, symlink it into
# sites-enabled, then:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# Note: only the web UI (port 8090) goes through this. The RTSP server
# (port 5544) isn't HTTP and can't be proxied this way - if you need it
# reachable outside your LAN, use a TLS-terminating TCP proxy (e.g.
# stunnel) or a VPN (Tailscale/WireGuard) instead, and keep in mind RTSP
# clients also need to reach it directly (see docs/ARCHITECTURE.md).

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name your-domain.example.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for /api/stream/:camera_id (WebRTC signaling over a
        # WebSocket) - without this nginx won't upgrade the connection
        # and live preview will fail to connect through the proxy.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example.com;
    return 301 https://$host$request_uri;
}
