[Unit]
Description=OmniMonitor NVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omnimonitor
Group=omnimonitor
# USB camera device nodes (/dev/videoN) are owned by group "video" on
# Debian/Ubuntu - the service account needs to be a member of it (the
# install script handles this), and this makes sure the group is active
# for this process even if group membership was granted after login.
SupplementaryGroups=video

Environment=OMNI_DATA_DIR=/var/lib/omnimonitor
Environment=OMNI_FRONTEND_DIST=/opt/omnimonitor/frontend/dist
# Uncomment to pick a fixed admin/RTSP password instead of the
# random-and-printed-once default (see README.md):
# Environment=OMNI_ADMIN_PASSWORD=changeme
# Environment=OMNI_RTSP_PASSWORD=changeme

WorkingDirectory=/var/lib/omnimonitor
ExecStart=/opt/omnimonitor/bin/omni-server
Restart=on-failure
RestartSec=2

# Sandboxing: this service only needs to read its own install directory,
# read/write its own data directory, open V4L2/network devices, and make
# outbound/inbound TCP+UDP connections (HTTP, RTSP, WebRTC/ICE) - nothing
# else on the system. Deliberately does NOT set `PrivateDevices=true`:
# that would block access to /dev/videoN along with everything else
# under /dev, breaking USB camera capture entirely - the option some
# hardening guides suggest by default isn't safe to apply blindly here.
#
# AF_NETLINK is required, not just the obvious AF_INET/AF_INET6/AF_UNIX:
# found by actually running this unit and hitting it. webrtc-rs's ICE
# agent enumerates local network interfaces (to gather host candidates)
# via getifaddrs(), which talks to the kernel over an AF_NETLINK socket
# under the hood on Linux even though nothing about "list my network
# interfaces" looks netlink-specific from the calling code. Without it,
# every socket() call for that enumeration fails with EAFNOSUPPORT
# (errno 97, logged as "Address family not supported by protocol") and
# ICE gathers zero local candidates - so every WebRTC live view hangs at
# "connecting" forever, correctly negotiating SDP but never actually
# reaching a connected media path. Confirmed via `journalctl -u
# omnimonitor`: the exact "Address family not supported by protocol (os
# error 97)" during ICE candidate gathering, with `RestrictAddressFamilies`
# as the only thing in this unit that could produce that specific error
# for a syscall the unsandboxed dev binary made successfully every time.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/omnimonitor
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
